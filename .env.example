# ============================================================================
# Yahoo Fantasy Sports OAuth 2.0 Credentials
# Create an app at https://developer.yahoo.com/apps/
# Select "Installed Application" or "Web Application"
# Redirect URI: https://localhost:8000/api/auth/yahoo/callback (or your Unraid IP/domain)
# API Permissions: Fantasy Sports -> Read/Write (fspt-w)
# ============================================================================
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:8000/api/auth/yahoo/callback

# ============================================================================
# Gmail SMTP Configuration (App Password)
# Generate an App Password at https://myaccount.google.com/apppasswords
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ============================================================================
# Scheduler & Autopilot Defaults
# ============================================================================
# Daily run time in 24h format (HH:MM) and timezone
DAILY_SYNC_TIME=08:00
TIMEZONE=America/New_York

# Default execution mode for newly discovered leagues:
#   advisory     -> Only send email & show web recommendations (never touch Yahoo lineup)
#   auto_lineup  -> Automatically swap bench/active starters in Yahoo, recommend FA pickups via email
DEFAULT_EXECUTION_MODE=advisory

# Global safety switch: if true, Yahoo write calls are logged/simulated unless overridden
DRY_RUN=true

# Database storage path (mapped to /data in Docker/Unraid)
DATA_DIR=./data
